{
  "version": 2,
  "installCommand": "corepack enable && corepack prepare pnpm@9.1.0 --activate && pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/",
    "ENABLE_EXPERIMENTAL_COREPACK": "1"
  },
  "routes": [
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
