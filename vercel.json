{
  "version": 2,
  "installCommand": "npm install -g pnpm@9 && pnpm install",
  "buildCommand": "pnpm --filter @workspace/crypto-tradepro run build",
  "outputDirectory": "artifacts/crypto-tradepro/dist/public",
  "framework": null,
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/"
  },
  "routes": [
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
